{
  "name": "payment-flow",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "setup:env": "bun scripts/setup-env.js",
    "setup": "bun run setup:env && bun install && bun run --cwd server db:seed",
    "start": "bun run --cwd server start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
